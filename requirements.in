# Direct runtime dependencies, for pip-compile. `pyproject.toml` stays the source of truth for
# what the package REQUIRES; this file exists to pin what a training box actually installs, so a
# run months from now resolves the same wheels.
#
#   pip install pip-tools
#   pip-compile requirements.in -o requirements.txt            # resolve and pin
#   pip-compile --upgrade requirements.in -o requirements.txt  # refresh
#   pip-sync requirements.txt                                  # install exactly that
#
# TORCH IS NOT PINNED HERE ON PURPOSE. The RTX 5090 is Blackwell (sm_120) and needs a build made
# for CUDA 12.8 or newer; the default PyPI wheel may not carry that architecture. Install torch
# FIRST, from the index that matches the card, then compile the rest against it:
#
#   pip install torch torchvision --index-url https://download.pytorch.org/whl/cu128
#   python -c "import torch; print(torch.__version__, torch.version.cuda, torch.cuda.get_arch_list())"
#     # 'sm_120' must appear in that list
#
# pip-compile would otherwise resolve a CPU-only or cu12x wheel from PyPI and the first CUDA call
# of an overnight run would be the thing that tells you.

torch>=2.1
torchvision>=0.16

