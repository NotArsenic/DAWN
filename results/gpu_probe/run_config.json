{
  "pairs": {
    "fallback_pixel_mask": "vehicles",
    "box_pixel_mask": "moving",
    "fallback_render_weight": 0.5,
    "eval_subset": "box_aligned",
    "report_fallback_separately": true
  },
  "grid": {
    "num_bins": 8,
    "ridge_alpha": 0.001,
    "refine_steps": 1,
    "stats_cache": "data/token_stats.pt",
    "stats_num_samples": 2000
  },
  "color": {
    "block": 4,
    "bin_step": 10,
    "soft_k": 5,
    "soft_sigma": 5.0,
    "min_patch_fraction": 0.5,
    "edge_quantile": 0.9,
    "upsample": "bilinear",
    "bgu": {
      "bins": 8,
      "grid": [
        64,
        80
      ],
      "ridge_alpha": 0.1,
      "refine_steps": 2
    }
  },
  "brightness_correction": {
    "enabled": false
  },
  "encoder": {
    "backend": "timm",
    "model_ids": {
      "timm": "vit_small_plus_patch16_dinov3.lvd1689m",
      "transformers": "facebook/dinov3-vits16plus-pretrain-lvd1689m"
    },
    "patch_size": 16,
    "input_size": [
      512,
      640
    ],
    "num_register_tokens": 4,
    "pretrained": true,
    "grad_checkpointing": true,
    "lora_rank": 8,
    "lora_alpha": 16,
    "lora_dropout": 0.0,
    "lora_lr": 0.0001,
    "lora_targets": {
      "timm": ".*blocks\\.\\d+\\.attn\\.(qkv|proj)",
      "transformers": [
        "q_proj",
        "k_proj",
        "v_proj",
        "o_proj"
      ]
    }
  },
  "velocity": {
    "hidden_dim": 256,
    "num_heads": 4,
    "num_blocks": 6,
    "mlp_ratio": 4,
    "dropout": 0.0,
    "dino_attn_gate_init": 0.0,
    "detach_dino_attn": true
  },
  "flow": {
    "num_train_steps": 50,
    "num_inference_steps": 2,
    "timesteps_per_image": 8,
    "render_size": [
      256,
      320
    ],
    "velocity_weight": 1.0,
    "render_weight": 0.1,
    "align_weight": 0.5,
    "color_weight": 0.2,
    "bin_count_weighting": true,
    "segment_balance": "per_value",
    "warmup_steps": 10,
    "warmup_ramp_steps": 500,
    "render_subset": 64
  },
  "optim": {
    "optimizer": "adamw",
    "lr": 0.0002,
    "weight_decay": 0.01,
    "betas": [
      0.9,
      0.999
    ],
    "batch_size": 16,
    "grad_clip": 1.0,
    "precision": "bf16",
    "ema_decay": 0.999,
    "ema_warmup": true,
    "lr_warmup_steps": 1000,
    "schedule": "cosine",
    "cosine": {
      "min_factor": 0.0
    },
    "one_cycle": {
      "pct_start": 0.2,
      "div_factor": 25.0,
      "final_div_factor": 10000.0,
      "cycle_momentum": true,
      "max_beta1": 0.95,
      "min_beta1": 0.85
    }
  },
  "loader": {
    "num_workers": 8,
    "pin_memory": true,
    "val_batch_size": 4
  },
  "logging": {
    "wandb_project": "dawn",
    "wandb_entity": "my-team",
    "wandb_mode": "disabled",
    "log_every": 5,
    "log_attn_gates": true,
    "watch_scope": "velocity",
    "watch_freq": 500,
    "save_every": 1000000,
    "val_every": 1000000,
    "num_val_samples": 8,
    "val_loss_batches": 8,
    "val_retrieval": true,
    "select_metric": "ciede2000",
    "metrics_csv": true
  },
  "dronevehicle": {
    "root": "data/DroneVehicle",
    "splits": [
      "train",
      "val",
      "test"
    ],
    "aligned_dir": "data/dronevehicle_aligned",
    "stats_csv": "data/stats/dronevehicle_stats.csv",
    "manifest_dir": "data/manifests",
    "outputs_dir": "outputs/data",
    "frame_size": [
      712,
      840
    ],
    "border": 100,
    "border_check": {
      "min_value": 200,
      "max_ring_white": 0.5
    },
    "class_map": {
      "car": "car",
      "truck": "truck",
      "bus": "bus",
      "van": "van",
      "freight_car": "freight_car",
      "feright_car": "freight_car",
      "feright car": "freight_car",
      "feright": "freight_car",
      "truvk": "truck",
      "*": null
    },
    "max_pairs": null
  },
  "day_filter": {
    "min_lum_median": 0.2,
    "histogram_bin_log10": 0.05,
    "sheet_count": 100,
    "band_log10": 0.15
  },
  "align": {
    "max_match_dist_px": 40,
    "copy_tol_px": 0.5,
    "exclude_copied_boxes": true,
    "ransac_inlier_px": 4,
    "ransac_enumerate_max": 40,
    "ransac_iterations": 500,
    "homography": {
      "enabled": true,
      "min_matches": 10,
      "ransac_iterations": 1000
    },
    "min_matches": 6,
    "min_inlier_ratio": 0.6,
    "max_median_residual_px": 2.0,
    "max_scale_deviation": 0.05,
    "max_rotation_deg": 2.0,
    "max_shift_px": 30.0,
    "grad_check": {
      "enabled": true,
      "blur_sigma": 1.0,
      "min_gain": -0.2,
      "search_px": 4,
      "max_best_shift_px": 3
    },
    "fallback": {
      "enabled": true,
      "search_px": 10,
      "min_prominence": 0.02,
      "max_quadrant_dev_px": 2
    },
    "moving": {
      "min_residual_px": 4,
      "dilate_px": 3
    }
  },
  "dedup": {
    "max_hamming": 6,
    "report_hamming": [
      4,
      6,
      8,
      10
    ],
    "sheet_count": 24
  },
  "masks": {
    "vehicles": {
      "dilate_px": 3,
      "extend_px": 17.4,
      "static_test": {
        "window_margin_px": 12,
        "search_px": 6,
        "max_residual_px": 2,
        "min_prominence": 0.02,
        "min_window_px": 32
      },
      "max_frame_fraction": 0.3
    }
  },
  "augment": {
    "hflip": 0.5,
    "vflip": 0.5,
    "rot90": false,
    "thermal_contrast": {
      "prob": 0.8,
      "black_point": [
        0.0,
        0.1
      ],
      "white_point": [
        0.9,
        1.0
      ],
      "gamma": [
        0.7,
        1.4
      ]
    }
  }
}
